datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id              Int           @id @default(autoincrement())
  name            String        @unique
  type            String        @default("expense")
  expectedAmount  Decimal?
  currentBalance  Decimal?
  transactions    Transaction[]
  rules           Rule[]
}

model Rule {
  id         String   @id @default(cuid())
  keyword    String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// תנועות מתוך קבצי הבנק/אשראי/ביט
model Transaction {
  id          Int       @id @default(autoincrement())
  date        DateTime
  description String
  amount      Decimal
  source      String    // 'Discount', 'Max', 'Bit Manual'
  monthKey    String    // '2026-08'
  isConfirmed Boolean   @default(false)
  
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// חוקים קשיחים והנחיות ל-AI
model AIRule {
  id              String    @id @default(cuid())
  ruleType        String    @default("prompt_instruction")
  instructionText String?
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
}

// Snapshots חודשיים של היסטוריית תקציב
model MonthlySnapshot {
  id        Int      @id @default(autoincrement())
  monthKey  String   @unique // '2026-08'
  data      Json     // שמירת מצב התקציב בדיוק כפי שהיה
  createdAt DateTime @default(now())
}