generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id               Int           @id @default(autoincrement())
  name             String        @unique
  type             String        @default("expense")
  isMaaserEligible Boolean       @default(true)
  isNeutralized    Boolean       @default(false)
  expectedAmount   Decimal?
  currentBalance   Decimal?
  transactions     Transaction[]
  rules            Rule[]
  budgets          Budget[]
}

model FinancialAccount {
  id           String        @id @default(cuid())
  name         String        @unique
  type         String        // "bank" | "credit_card"
  provider     String        // "poalim", "max", "isracard", "cal", "discount"
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  transactions Transaction[]
}

model Transaction {
  id               String            @id @default(cuid())
  date             DateTime
  description      String
  amount           Decimal
  monthKey         String
  
  // קישור יחיד ומדויק לחשבון
  accountId        String?
  account          FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  categoryId       Int
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isMaaserEligible Boolean           @default(true)
  createdAt        DateTime          @default(now())

  bankMatches      CreditMatch[]     @relation("BankTransaction")
  creditMatches    CreditMatch[]     @relation("CreditTransaction")
}

model CreditMatch {
  id                  String      @id @default(cuid())
  monthKey            String
  bankTransactionId   String
  bankTransaction     Transaction @relation("BankTransaction", fields: [bankTransactionId], references: [id], onDelete: Cascade)
  creditTransactionId String
  creditTransaction   Transaction @relation("CreditTransaction", fields: [creditTransactionId], references: [id], onDelete: Cascade)
  createdAt           DateTime    @default(now())

  @@unique([bankTransactionId, creditTransactionId])
}

model Rule {
  id         String   @id @default(cuid())
  keyword    String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model AIRule {
  id              String    @id @default(cuid())
  ruleType        String    @default("prompt_instruction")
  instructionText String?
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
}

model Budget {
  id         String   @id @default(cuid())
  monthKey   String
  amount     Decimal
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([monthKey, categoryId])
}

model MaaserSettings {
  id             Int     @id @default(1)
  initialBalance Decimal @default(0)
  percentage     Decimal @default(10)
}