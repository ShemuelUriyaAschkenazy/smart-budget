generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id                   Int           @id @default(autoincrement())
  name                 String        @unique
  type                 String        @default("expense")
  countInMaaserDefault Boolean       @default(true)
  isNeutralized        Boolean       @default(false)
  expectedAmount       Decimal?
  currentBalance       Decimal?
  transactions         Transaction[]
  rules                Rule[]
  budgets              Budget[]
}

model FinancialAccount {
  id            String        @id @default(cuid())
  name          String        @unique
  type          String        // 'bank' | 'credit_card'
  provider      String        // 'max' | 'isracard' | 'cal' | 'poalim'
  last4Digits   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  transactions  Transaction[]
  importBatches ImportBatch[]
}

model ImportBatch {
  id           String            @id @default(cuid())
  createdAt    DateTime          @default(now())
  fileName     String?
  provider     String
  accountId    String?
  account      FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  amount      Decimal
  monthKey    String

  accountId String?
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // null = יורש מהקטגוריה, true/false = נערך ידנית בתנועה
  countInMaaser Boolean?
  createdAt     DateTime @default(now())

  bankMatches   CreditMatch[] @relation("BankTransaction")
  creditMatches CreditMatch[] @relation("CreditTransaction")

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
}

model CreditMatch {
  id                  String      @id @default(cuid())
  monthKey            String
  bankTransactionId   String
  bankTransaction     Transaction @relation("BankTransaction", fields: [bankTransactionId], references: [id], onDelete: Cascade)
  creditTransactionId String
  creditTransaction   Transaction @relation("CreditTransaction", fields: [creditTransactionId], references: [id], onDelete: Cascade)
  createdAt           DateTime    @default(now())

  @@unique([bankTransactionId, creditTransactionId])
}

model Rule {
  id         String   @id @default(cuid())
  keyword    String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model AIRule {
  id              String    @id @default(cuid())
  ruleType        String    @default("prompt_instruction")
  instructionText String?
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
}

model Budget {
  id         String   @id @default(cuid())
  monthKey   String
  amount     Decimal
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([monthKey, categoryId])
}

model MaaserSettings {
  id             Int     @id @default(1)
  initialBalance Decimal @default(0)
  percentage     Decimal @default(10)
}