generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id               Int           @id @default(autoincrement())
  name             String        @unique
  type             String        @default("expense") // "income" | "expense" | "savings" | "donations" | "transfer"
  isMaaserEligible Boolean       @default(true)
  isNeutralized    Boolean       @default(false) // V - מנוטרל מחישובי הוצאות ומעשר (כמו כיסוי חיוב אשראי)
  expectedAmount   Decimal?
  currentBalance   Decimal?
  transactions     Transaction[]
  rules            Rule[]
  budgets          Budget[]
}

model Transaction {
  id               String   @id @default(cuid())
  date             DateTime
  description      String
  amount           Decimal
  source           String?
  monthKey         String
  categoryId       Int
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isMaaserEligible Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Rule {
  id         String   @id @default(cuid())
  keyword    String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model AIRule {
  id              String    @id @default(cuid())
  ruleType        String    @default("prompt_instruction")
  instructionText String?
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
}

model Budget {
  id         String   @id @default(cuid())
  monthKey   String
  amount     Decimal
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([monthKey, categoryId])
}

model MaaserSettings {
  id             Int     @id @default(1)
  initialBalance Decimal @default(0)
  percentage     Decimal @default(10)
}